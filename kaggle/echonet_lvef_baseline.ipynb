   "source": [
    "# Automated LVEF Estimation: Spatiotemporal Baseline Model\n",
    "### R(2+1)D-18 on Stanford EchoNet-Dynamic Dataset\n",
    "\n",
    "This notebook trains and evaluates the baseline video regression model for continuous Left Ventricular Ejection Fraction (LVEF %) estimation from Apical-4-Chamber (A4C) echocardiograms (Ouyang et al., Nature 2020).\n",
    "\n",
    "**Hardware & Environment Requirements**:\n",
    "1. **Accelerator**: Kaggle GPU (`Settings -> Accelerator -> GPU T4 x2` or `P100`).\n",
    "2. **Internet**: `On` (required for cloning GitHub repo and downloading Kinetics-400 weights).\n",
    "3. **Dataset**: Click `+ Add Input` and attach the `echonet-dynamic` dataset containing `FileList.csv`, `VolumeTracings.csv`, and `Videos/`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Verify GPU Acceleration and Environment\n",
    "import torch\n",
    "print(f\"PyTorch Version: {torch.__version__}\")\n",
    "print(f\"CUDA Available: {torch.cuda.is_available()}\")\n",
    "assert torch.cuda.is_available(), \"GPU is required. Enable it in Settings -> Accelerator.\"\n",
    "print(f\"GPU Device: {torch.cuda.get_device_name(0)}\")\n",
    "!nvidia-smi"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2. Clone or Sync GitHub Baseline Repository\n",
    "import os\n",
    "if not os.path.exists(\"src\"):\n",
    "    !git clone https://github.com/ThRavi95/Echonet_LVEF_baseline.git .\n",
    "else:\n",
    "    !git fetch origin main\n",
    !git reset --hard origin/main\n",
    "!git log -n 1 --oneline"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 3. Verify EchoNet-Dynamic Dataset Attachment\n",
    "import glob, os\n",
    "matches = glob.glob(\"/kaggle/input/**/FileList.csv\", recursive=True)\n",
    "assert matches, (\n",
    "    \"[ACTION REQUIRED] EchoNet-Dynamic dataset not found in /kaggle/input. \"\n",
    "    \"Click '+ Add Input' on the right sidebar and attach 'echonet-dynamic'.\"\n",
    ")\n",
    "DATA_DIR = os.path.dirname(matches[0])\n",
    "print(f\"[SUCCESS] EchoNet-Dynamic dataset found at: {DATA_DIR}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4. Launch Baseline R(2+1)D-18 Training & Multi-Clip Test Evaluation\n",
    "# --resume automatically continues from /kaggle/working/outputs/last_checkpoint.pt if present.\n",
    "!python kaggle/train_kaggle.py \\\n",
    "    --data_dir \"{DATA_DIR}\" \\\n",
    "    --output_dir /kaggle/working/outputs \\\n",
    "    --epochs 25 \\\n",
    "    --batch_size 16 \\\n",
    "    --num_workers 4 \\\n",
    "    --num_test_clips 4 \\\n",
    "    --resume"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 5. Display Clinical Evaluation Results & Visualizations\n",
    "from IPython.display import Image, display\n",
    "import json, os\n",
    "\n",
    "metrics_file = \"/kaggle/working/outputs/test_metrics.json\"\n",
    "assert os.path.exists(metrics_file), f\"Missing {metrics_file}; verify training completed.\"\n",
    "assert os.path.exists(\"/kaggle/working/outputs/best_r2plus1d_lvef.pt\"), \"Missing best_r2plus1d_lvef.pt\"\n",
    "\n",
    "with open(metrics_file, \"r\") as f:\n",
    "    m = json.load(f)\n",
    "print(\"=\" * 55)\n",
    "print(f\"OFFICIAL TEST SET CLINICAL EVALUATION (N={m['sample_count']} VIDEOS)\")\n",
    "print(\"=\" * 55)\n",
    "print(f\"Mean Absolute Error (MAE):      {m['mae']:.2f}%\")\n",
    "print(f\"Root Mean Squared Error (RMSE): {m['rmse']:.2f}%\")\n",
    "print(f\"Pearson Correlation (r):        {m['pearson_r']:.3f}\")\n",
    "print(f\"Coefficient of Det. (R2):       {m['r2']:.3f}\")\n",
    "print(f\"Bland-Altman Bias:              {m['bland_altman_bias']:.2f}%\")\n",
    "print(f\"Limits of Agreement:            [{m['bland_altman_lower_loa']:.2f}%, {m['bland_altman_upper_loa']:.2f}%]\")\n",
    "print(f\"Low EF (<50%) Accuracy:         {m['binary_low_ef_accuracy']*100:.1f}%\")\n",
    "print(\"=\" * 55)\n",
    "\n",
    "for fig_name in [\"training_curves.png\", \"test_scatter.png\", \"test_bland_altman.png\"]:\n",
    "    fig_path = f\"/kaggle/working/outputs/{fig_name}\"\n",
    "    if os.path.exists(fig_path):\n",
    "        print(f\"\\nFigure: {fig_name}\")\n",
    "        display(Image(filename=fig_path))"
   ]
  }
 ],
